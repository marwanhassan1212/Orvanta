@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Orvanta</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Orvanta.styles.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="mobile-scrim" id="mobileScrim"></div>

    <div class="app-shell">
        <aside class="side-rail" id="sideRail">
            <div class="brand-header">
                <a asp-controller="Home" asp-action="Index" class="brand-mark-wrap">
                    <span class="brand-emblem">O</span>
                    <div>
                        <div class="brand-wordmark">Orvanta</div>
                        <div class="brand-edition">Enterprise ERP</div>
                    </div>
                </a>
                <button type="button" class="btn btn-sm text-white-50 d-lg-none p-1" id="closeRailBtn" aria-label="Close">
                    <i class="bi bi-x-lg fs-5"></i>
                </button>
            </div>

            <nav class="side-menu">
                <a class="menu-link @(currentController == "Home" ? "is-active" : "")"
                   asp-controller="Home" asp-action="Index">
                    <i class="bi bi-grid-1x2"></i>
                    <span>Overview</span>
                </a>

                <div class="menu-group">Catalog &amp; Partners</div>

                <a class="menu-link @(currentController == "Categories" ? "is-active" : "")"
                   asp-controller="Categories" asp-action="Index">
                    <i class="bi bi-layers"></i>
                    <span>Categories</span>
                </a>

                <a class="menu-link @(currentController == "Units" ? "is-active" : "")"
                   asp-controller="Units" asp-action="Index">
                    <i class="bi bi-rulers"></i>
                    <span>Units</span>
                </a>

                <a class="menu-link @(currentController == "Products" ? "is-active" : "")"
                   asp-controller="Products" asp-action="Index">
                    <i class="bi bi-box-seam"></i>
                    <span>Products</span>
                </a>

                <a class="menu-link @(currentController == "Customers" ? "is-active" : "")"
                   asp-controller="Customers" asp-action="Index">
                    <i class="bi bi-people"></i>
                    <span>Customers</span>
                </a>

                <a class="menu-link @(currentController == "Suppliers" ? "is-active" : "")"
                   asp-controller="Suppliers" asp-action="Index">
                    <i class="bi bi-truck"></i>
                    <span>Suppliers</span>
                </a>

                <a class="menu-link @(currentController == "Warehouses" ? "is-active" : "")"
                   asp-controller="Warehouses" asp-action="Index">
                    <i class="bi bi-buildings"></i>
                    <span>Warehouses</span>
                </a>

                <div class="menu-group">Operations</div>

                <a class="menu-link @(currentController == "Inventory" ? "is-active" : "")"
                   asp-controller="Inventory" asp-action="Index">
                    <i class="bi bi-archive"></i>
                    <span>Inventory</span>
                </a>

                <a class="menu-link @(currentController == "Sales" ? "is-active" : "")"
                   asp-controller="Sales" asp-action="Index">
                    <i class="bi bi-bag-check"></i>
                    <span>Sales</span>
                </a>

                <a class="menu-link @(currentController == "Purchases" ? "is-active" : "")"
                   asp-controller="Purchases" asp-action="Index">
                    <i class="bi bi-cart3"></i>
                    <span>Purchases</span>
                </a>

                <a class="menu-link @(currentController == "Payments" ? "is-active" : "")"
                   asp-controller="Payments" asp-action="Index">
                    <i class="bi bi-wallet2"></i>
                    <span>Payments</span>
                </a>

                <a class="menu-link @(currentController == "Expenses" ? "is-active" : "")"
                   asp-controller="Expenses" asp-action="Index">
                    <i class="bi bi-receipt"></i>
                    <span>Expenses</span>
                </a>

                <div class="menu-group">System</div>

                @if (User.IsInRole("Admin"))
                {
                    <a class="menu-link @(currentController == "UserManagement" ? "is-active" : "")"
                       asp-controller="UserManagement" asp-action="Index">
                        <i class="bi bi-shield-lock"></i>
                        <span>User Management</span>
                    </a>
                }

                <a class="menu-link @(currentController == "Reports" ? "is-active" : "")"
                   asp-controller="Reports" asp-action="Index">
                    <i class="bi bi-graph-up-arrow"></i>
                    <span>Reports</span>
                </a>
            </nav>
        </aside>

        <div class="main-area">
            <header class="top-header">
                <div class="d-flex align-items-center gap-3">
                    <button type="button" class="btn btn-subtle d-lg-none py-1 px-2" id="openRailBtn" aria-label="Open menu">
                        <i class="bi bi-list fs-5"></i>
                    </button>
                    <div class="d-none d-sm-flex align-items-center gap-2 small text-secondary">
                        <i class="bi bi-diamond-fill" style="font-size: 0.45rem; color: var(--gold-primary);"></i>
                        <span>Orvanta Workspace</span>
                    </div>
                </div>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    var initial = string.IsNullOrWhiteSpace(User.Identity.Name)
                    ? "U"
                    : User.Identity.Name.Substring(0, 1).ToUpperInvariant();

                    <div class="dropdown">
                        <a href="#" class="d-flex align-items-center gap-2 text-decoration-none dropdown-toggle"
                           data-bs-toggle="dropdown" aria-expanded="false" style="color: var(--ink-primary);">
                            <span class="profile-chip">@initial</span>
                            <div class="d-none d-md-block text-start lh-sm">
                                <div class="fw-semibold small">@User.Identity.Name</div>
                                <div style="font-size: 0.72rem; color: var(--ink-secondary);">
                                    @(User.IsInRole("Admin") ? "Administrator" : "Staff")
                                </div>
                            </div>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2" style="border-radius: 12px; min-width: 200px;">
                            <li>
                                <a class="dropdown-item py-2" asp-controller="Account" asp-action="ChangePassword">
                                    <i class="bi bi-key me-2 text-secondary"></i> Change Password
                                </a>
                            </li>
                            <li><hr class="dropdown-divider my-1" /></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item py-2 text-danger">
                                        <i class="bi bi-box-arrow-right me-2"></i> Sign Out
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
            </header>

            <main class="workspace-body">
                <div class="page-header-bar">
                    <div>
                        @if (ViewData["Subtitle"] != null)
                        {
                            <div class="page-eyebrow">@ViewData["Subtitle"]</div>
                        }
                        <h1 class="page-title">@ViewData["Title"]</h1>
                    </div>

                    @if (IsSectionDefined("PageActions"))
                    {
                        <div class="d-flex align-items-center gap-2">
                            @await RenderSectionAsync("PageActions", required: false)
                        </div>
                    }
                </div>

                @RenderBody()
            </main>

            <footer class="app-footer">
                <span>&copy; 2026 Orvanta. All rights reserved.</span>
                <span class="d-none d-sm-inline">Inventory &amp; Sales Management</span>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        (function () {
            const rail = document.getElementById('sideRail');
            const scrim = document.getElementById('mobileScrim');
            const openBtn = document.getElementById('openRailBtn');
            const closeBtn = document.getElementById('closeRailBtn');

            function toggleRail(show) {
                if (!rail || !scrim) return;
                rail.classList.toggle('is-open', show);
                scrim.classList.toggle('is-open', show);
            }

            openBtn?.addEventListener('click', () => toggleRail(true));
            closeBtn?.addEventListener('click', () => toggleRail(false));
            scrim?.addEventListener('click', () => toggleRail(false));

            if (typeof Swal !== 'undefined') {
                const notify = Swal.mixin({
                    toast: true,
                    position: 'top-end',
                    showConfirmButton: false,
                    timer: 3200,
                    timerProgressBar: true
                });

                @if (TempData["Success"] != null)
                {
                        <text>notify.fire({ icon: 'success', title: '@TempData["Success"]' });</text>
                }
                @if (TempData["SuccessMessage"] != null)
                {
                        <text>notify.fire({ icon: 'success', title: '@TempData["SuccessMessage"]' });</text>
                }
                @if (TempData["Error"] != null)
                {
                        <text>notify.fire({ icon: 'error', title: '@TempData["Error"]' });</text>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                        <text>notify.fire({ icon: 'error', title: '@TempData["ErrorMessage"]' });</text>
                }
            }
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>