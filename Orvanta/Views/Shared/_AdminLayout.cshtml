@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
    var pageTitle = ViewData["Title"]?.ToString() ?? "Orvanta";
    var pageSubtitle = ViewData["Subtitle"]?.ToString();
    var userName = User.Identity?.Name ?? "User";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle - Orvanta</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@4.0.0-beta3/dist/css/adminlte.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" />
    <link rel="stylesheet" href="~/css/orvanta-theme.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="layout-fixed sidebar-expand-lg">
    <div class="app-wrapper">

        <!-- Top Navbar -->
        <nav class="app-header navbar navbar-expand bg-body border-bottom">
            <div class="container-fluid">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link" data-lte-toggle="sidebar" href="#" role="button" aria-label="Toggle navigation">
                            <i class="bi bi-list fs-5"></i>
                        </a>
                    </li>
                    <li class="nav-item d-none d-md-flex align-items-center ms-2">
                        <span class="text-secondary small fw-medium">Orvanta ERP</span>
                    </li>
                </ul>

                <ul class="navbar-nav ms-auto align-items-center gap-2">
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item dropdown">
                            <a href="#" class="nav-link dropdown-toggle d-flex align-items-center gap-2" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-circle fs-5"></i>
                                <span class="d-none d-sm-inline small fw-semibold">@userName</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                <li class="px-3 py-2 border-bottom">
                                    <div class="fw-semibold small">@userName</div>
                                    <div class="text-secondary" style="font-size: 0.78rem;">
                                        @(User.IsInRole("Admin") ? "Administrator" : "Staff")
                                    </div>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Account" asp-action="ChangePassword">
                                        <i class="bi bi-key me-2"></i>Change Password
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider my-1" /></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item py-2 text-danger">
                                            <i class="bi bi-box-arrow-right me-2"></i>Sign Out
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                </ul>
            </div>
        </nav>

        <!-- Sidebar -->
        <aside class="app-sidebar bg-dark shadow" data-bs-theme="dark">
            <div class="sidebar-brand px-3 py-3 border-bottom border-secondary border-opacity-25">
                <a asp-controller="Home" asp-action="Index" class="brand-link d-flex align-items-center gap-2 text-decoration-none">
                    <span class="orvanta-brand-badge">O</span>
                    <div class="d-flex flex-column">
                        <span class="brand-text fw-bold text-white lh-1">Orvanta</span>
                        <span class="orvanta-gold-text text-uppercase fw-semibold mt-1" style="font-size: 0.65rem; letter-spacing: 0.14em;">Enterprise ERP</span>
                    </div>
                </a>
            </div>

            <div class="sidebar-wrapper">
                <nav class="mt-2">
                    <ul class="nav sidebar-menu flex-column" data-lte-toggle="treeview" role="menu" data-accordion="false">

                        <li class="nav-item">
                            <a asp-controller="Home" asp-action="Index"
                               class="nav-link @(currentController == "Home" ? "active" : "")">
                                <i class="nav-icon bi bi-speedometer2"></i>
                                <p>Overview</p>
                            </a>
                        </li>

                        <li class="nav-header text-uppercase small mt-2">Catalog &amp; Partners</li>

                        <li class="nav-item">
                            <a asp-controller="Categories" asp-action="Index"
                               class="nav-link @(currentController == "Categories" ? "active" : "")">
                                <i class="nav-icon bi bi-layers"></i>
                                <p>Categories</p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a asp-controller="Units" asp-action="Index"
                               class="nav-link @(currentController == "Units" ? "active" : "")">
                                <i class="nav-icon bi bi-rulers"></i>
                                <p>Units</p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a asp-controller="Products" asp-action="Index"
                               class="nav-link @(currentController == "Products" ? "active" : "")">
                                <i class="nav-icon bi bi-box-seam"></i>
                                <p>Products</p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a asp-controller="Customers" asp-action="Index"
                               class="nav-link @(currentController == "Customers" ? "active" : "")">
                                <i class="nav-icon bi bi-people"></i>
                                <p>Customers</p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a asp-controller="Suppliers" asp-action="Index"
                               class="nav-link @(currentController == "Suppliers" ? "active" : "")">
                                <i class="nav-icon bi bi-truck"></i>
                                <p>Suppliers</p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a asp-controller="Warehouses" asp-action="Index"
                               class="nav-link @(currentController == "Warehouses" ? "active" : "")">
                                <i class="nav-icon bi bi-buildings"></i>
                                <p>Warehouses</p>
                            </a>
                        </li>

                        <li class="nav-header text-uppercase small mt-2">Operations</li>

                        <li class="nav-item">
                            <a asp-controller="Inventory" asp-action="Index"
                               class="nav-link @(currentController == "Inventory" ? "active" : "")">
                                <i class="nav-icon bi bi-archive"></i>
                                <p>Inventory</p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a asp-controller="Sales" asp-action="Index"
                               class="nav-link @(currentController == "Sales" ? "active" : "")">
                                <i class="nav-icon bi bi-bag-check"></i>
                                <p>Sales</p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a asp-controller="Purchases" asp-action="Index"
                               class="nav-link @(currentController == "Purchases" ? "active" : "")">
                                <i class="nav-icon bi bi-cart3"></i>
                                <p>Purchases</p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a asp-controller="Payments" asp-action="Index"
                               class="nav-link @(currentController == "Payments" ? "active" : "")">
                                <i class="nav-icon bi bi-wallet2"></i>
                                <p>Payments</p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a asp-controller="Expenses" asp-action="Index"
                               class="nav-link @(currentController == "Expenses" ? "active" : "")">
                                <i class="nav-icon bi bi-receipt"></i>
                                <p>Expenses</p>
                            </a>
                        </li>

                        <li class="nav-header text-uppercase small mt-2">System</li>

                        <li class="nav-item">
                            <a asp-controller="UserManagement" asp-action="Index"
                               class="nav-link @(currentController == "UserManagement" ? "active" : "")">
                                <i class="nav-icon bi bi-shield-lock"></i>
                                <p>User Management</p>
                            </a>
                        </li>

                        <li class="nav-item @(currentController == "Reports" ? "menu-open" : "")">
                            <a href="#" class="nav-link @(currentController == "Reports" ? "active" : "")">
                                <i class="nav-icon bi bi-graph-up-arrow"></i>
                                <p>
                                    Reports
                                    <i class="nav-arrow bi bi-chevron-right"></i>
                                </p>
                            </a>
                            <ul class="nav nav-treeview">
                                <li class="nav-item">
                                    <a asp-controller="Reports" asp-action="Index"
                                       class="nav-link @(currentController == "Reports" && currentAction == "Index" ? "active" : "")">
                                        <i class="nav-icon bi bi-circle"></i>
                                        <p>Reports Overview</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-controller="Reports" asp-action="Sales"
                                       class="nav-link @(currentController == "Reports" && currentAction == "Sales" ? "active" : "")">
                                        <i class="nav-icon bi bi-circle"></i>
                                        <p>Sales Report</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-controller="Reports" asp-action="Purchases"
                                       class="nav-link @(currentController == "Reports" && currentAction == "Purchases" ? "active" : "")">
                                        <i class="nav-icon bi bi-circle"></i>
                                        <p>Purchases Report</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-controller="Reports" asp-action="Inventory"
                                       class="nav-link @(currentController == "Reports" && currentAction == "Inventory" ? "active" : "")">
                                        <i class="nav-icon bi bi-circle"></i>
                                        <p>Inventory Report</p>
                                    </a>
                                </li>
                            </ul>
                        </li>

                    </ul>
                </nav>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="app-main">
            <div class="app-content-header py-3 border-bottom bg-body-tertiary">
                <div class="container-fluid d-flex flex-wrap align-items-center justify-content-between gap-2">
                    <div>
                        <h1 class="h4 fw-bold mb-0">@pageTitle</h1>
                        @if (!string.IsNullOrWhiteSpace(pageSubtitle))
                        {
                            <div class="text-secondary small">@pageSubtitle</div>
                        }
                    </div>

                    @if (IsSectionDefined("PageActions"))
                    {
                        <div class="d-flex align-items-center gap-2">
                            @await RenderSectionAsync("PageActions", required: false)
                        </div>
                    }
                </div>
            </div>

            <div class="app-content py-4">
                <div class="container-fluid">
                    @RenderBody()
                </div>
            </div>
        </main>

        <!-- Footer -->
        <footer class="app-footer py-3 px-4 border-top bg-body small text-secondary d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>&copy; 2026 <strong>Orvanta</strong></div>
            <div>Inventory &amp; Sales Management</div>
        </footer>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/admin-lte@4.0.0-beta3/dist/js/adminlte.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        (function () {
            if (typeof Swal === 'undefined') {
                return;
            }
            var toast = Swal.mixin({
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 3000,
                timerProgressBar: true
            });

            @if (TempData["Success"] != null)
            {
                    <text>toast.fire({ icon: 'success', title: '@TempData["Success"]' });</text>
            }
            @if (TempData["SuccessMessage"] != null)
            {
                    <text>toast.fire({ icon: 'success', title: '@TempData["SuccessMessage"]' });</text>
            }
            @if (TempData["Error"] != null)
            {
                    <text>toast.fire({ icon: 'error', title: '@TempData["Error"]' });</text>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                    <text>toast.fire({ icon: 'error', title: '@TempData["ErrorMessage"]' });</text>
            }
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>