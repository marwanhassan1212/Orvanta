@model Orvanta.ViewModels.Categories.CategoryUpdateViewModel
@{
    ViewData["Title"] = "Edit Category";
    ViewData["Subtitle"] = "Categories";
    Layout = "_AdminLayout";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-9 col-lg-7 col-xl-6">
        <div class="data-card">
            <div class="data-card-head">
                <h2 class="h6 fw-semibold mb-0">Edit Category</h2>
                <div class="text-secondary small">Update category details and description</div>
            </div>

            <div class="data-card-body">
                @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                {
                    <div class="alert alert-danger py-2 px-3 small mb-3" role="alert">
                        @foreach (var err in ViewData.ModelState[string.Empty]!.Errors)
                        {
                            <div>@err.ErrorMessage</div>
                        }
                    </div>
                }

                <form asp-controller="Categories" asp-action="Edit" asp-route-id="@Model.Id" method="post" autocomplete="off">
                    @Html.AntiForgeryToken()
                    <input asp-for="Id" type="hidden" />

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-controller="Categories" asp-action="Index" class="btn btn-subtle">Cancel</a>
                        <button type="submit" class="btn btn-primary-dark">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}