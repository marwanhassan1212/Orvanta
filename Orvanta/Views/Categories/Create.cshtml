@model Orvanta.ViewModels.Categories.CategoryCreateViewModel
@{
    ViewData["Title"] = "Add Category";
    ViewData["Subtitle"] = "Categories";
    Layout = "_AdminLayout";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8 col-xl-7">
        <div class="card">
            <div class="card-header bg-transparent py-3">
                <h2 class="h6 fw-bold mb-0">Create Category</h2>
                <div class="text-secondary small">Add a new product category to organize your catalog</div>
            </div>

            <div class="card-body">
                @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                {
                    <div class="alert alert-danger py-2 px-3 small mb-3" role="alert">
                        @foreach (var err in ViewData.ModelState[string.Empty]!.Errors)
                        {
                            <div>@err.ErrorMessage</div>
                        }
                    </div>
                }

                <form asp-controller="Categories" asp-action="Create" method="post" autocomplete="off">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold"></label>
                        <input asp-for="Name" class="form-control" placeholder="Electronics" />
                        <span asp-validation-for="Name" class="text-danger small d-block mt-1"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label fw-semibold"></label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Optional category description..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small d-block mt-1"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-controller="Categories" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary">Save Category</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}