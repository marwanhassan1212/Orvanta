@using Orvanta.ViewModels.Suppliers
@model dynamic
@{
    ViewData["Title"] = "Suppliers";
    ViewData["Subtitle"] = "Catalog & Partners";
    Layout = "_AdminLayout";

    var canManage = User.IsInRole("Admin") || User.IsInRole("Manager");
    var filter = ViewBag.Filter as SupplierFilterViewModel ?? new SupplierFilterViewModel();

    var rawItems = Model?.Items as System.Collections.IEnumerable ?? Model as System.Collections.IEnumerable;
    var list = new List<SupplierListViewModel>();
    if (rawItems != null)
    {
        foreach (var row in rawItems)
        {
            if (row is SupplierListViewModel vm)
            {
                list.Add(vm);
            }
        }
    }

    int totalCount = Model?.TotalCount != null ? (int)Model.TotalCount : list.Count;
    int pageNumber = Model?.PageNumber != null ? (int)Model.PageNumber : (filter.PageNumber > 0 ? filter.PageNumber : 1);
    int pageSize = Model?.PageSize != null ? (int)Model.PageSize : (filter.PageSize > 0 ? filter.PageSize : 10);
    int totalPages = Model?.TotalPages != null ? (int)Model.TotalPages : (totalCount > 0 ? ((totalCount - 1) / pageSize) + 1 : 1);
    if (totalPages < 1) { totalPages = 1; }

    int activeCount = 0;
    int inactiveCount = 0;
    foreach (var row in list)
    {
        if (row.IsActive) { activeCount++; }
        else { inactiveCount++; }
    }

    var sortBy = string.IsNullOrEmpty(filter.SortBy) ? "name" : filter.SortBy.ToLower();
    var sortDir = string.IsNullOrEmpty(filter.SortDirection) ? "asc" : filter.SortDirection.ToLower();
}

@if (canManage)
{
    @section PageActions {
        <a asp-controller="Suppliers" asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i> Add Supplier
        </a>
    }
}

<div class="row g-3 mb-4">
    <div class="col-12 col-md-4">
        <div class="card h-100">
            <div class="card-body d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-secondary small fw-semibold">Total Suppliers</div>
                    <div class="fs-2 fw-bold mt-1">@totalCount</div>
                </div>
                <span class="rounded-3 bg-light p-3 text-dark fs-4">
                    <i class="bi bi-truck"></i>
                </span>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-4">
        <div class="card h-100">
            <div class="card-body d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-secondary small fw-semibold">Active</div>
                    <div class="fs-2 fw-bold mt-1 text-success">@activeCount</div>
                </div>
                <span class="rounded-3 bg-success-subtle p-3 text-success fs-4">
                    <i class="bi bi-check2-circle"></i>
                </span>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-4">
        <div class="card h-100">
            <div class="card-body d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-secondary small fw-semibold">Inactive</div>
                    <div class="fs-2 fw-bold mt-1 text-danger">@inactiveCount</div>
                </div>
                <span class="rounded-3 bg-danger-subtle p-3 text-danger fs-4">
                    <i class="bi bi-slash-circle"></i>
                </span>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header bg-transparent py-3">
        <form asp-controller="Suppliers" asp-action="Index" method="get" id="supplierFilterForm"
              class="d-flex flex-wrap flex-lg-nowrap align-items-center justify-content-between gap-2">
            <div class="d-flex flex-wrap flex-md-nowrap align-items-center gap-2 flex-grow-1">
                <input type="text"
                       name="SearchTerm"
                       value="@filter.SearchTerm"
                       class="form-control"
                       style="min-width: 220px;"
                       placeholder="Search name, phone, or email..." />

                <select name="IsActive" class="form-select flex-shrink-0" style="width: 155px;">
                    <option value="">All Statuses</option>
                    <option value="true" selected="@(filter.IsActive == true ? "selected" : null)">Active</option>
                    <option value="false" selected="@(filter.IsActive == false ? "selected" : null)">Inactive</option>
                </select>

                <select name="SortBy" class="form-select flex-shrink-0" style="width: 155px;">
                    <option value="name" selected="@(sortBy == "name" ? "selected" : null)">Sort: Name</option>
                    <option value="createdat" selected="@(sortBy == "createdat" ? "selected" : null)">Sort: Created</option>
                </select>

                <select name="SortDirection" class="form-select flex-shrink-0" style="width: 120px;">
                    <option value="asc" selected="@(sortDir == "asc" ? "selected" : null)">Asc</option>
                    <option value="desc" selected="@(sortDir == "desc" ? "selected" : null)">Desc</option>
                </select>

                <input type="hidden" name="PageNumber" id="supplierPageNumber" value="1" />
                <input type="hidden" name="PageSize" value="@pageSize" />

                <button type="submit" class="btn btn-dark flex-shrink-0">Filter</button>
                <a asp-controller="Suppliers" asp-action="Index" class="btn btn-outline-secondary flex-shrink-0">Reset</a>
            </div>

            <span class="text-secondary small text-nowrap ms-lg-2">@totalCount records</span>
        </form>
    </div>

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="suppliersTable">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Supplier</th>
                        <th>Phone</th>
                        <th>Email</th>
                        <th>Created</th>
                        <th>Status</th>
                        <th class="pe-4 text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (list.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-center text-secondary py-5">No suppliers found.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in list)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold">@item.Name</td>
                                <td class="@(string.IsNullOrWhiteSpace(item.Phone) ? "text-secondary" : "")">
                                    @(string.IsNullOrWhiteSpace(item.Phone) ? "—" : item.Phone)
                                </td>
                                <td class="text-secondary">
                                    @(string.IsNullOrWhiteSpace(item.Email) ? "—" : item.Email)
                                </td>
                                <td class="text-secondary small">
                                    @item.CreatedAt.ToString("yyyy-MM-dd")
                                </td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge text-bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-2">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-2">Inactive</span>
                                    }
                                </td>
                                <td class="pe-4 text-end">
                                    <div class="d-inline-flex align-items-center gap-1">
                                        <a asp-controller="Suppliers"
                                           asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-secondary"
                                           title="Details">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        @if (canManage)
                                        {
                                            <a asp-controller="Suppliers"
                                               asp-action="Edit"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-secondary"
                                               title="Edit">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>

                                            <form asp-controller="Suppliers"
                                                  asp-action="ToggleStatus"
                                                  asp-route-id="@item.Id"
                                                  method="post"
                                                  class="d-inline m-0 js-toggle-supplier"
                                                  data-active="@(item.IsActive ? "true" : "false")">
                                                @Html.AntiForgeryToken()
                                                @if (item.IsActive)
                                                {
                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-danger"
                                                            title="Deactivate">
                                                        <i class="bi bi-slash-circle"></i>
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-success"
                                                            title="Activate">
                                                        <i class="bi bi-check-circle"></i>
                                                    </button>
                                                }
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (totalPages > 1)
    {
        <div class="card-footer bg-transparent d-flex flex-wrap align-items-center justify-content-between gap-2">
            <div class="text-secondary small">
                Page @pageNumber of @totalPages
            </div>

            <div class="d-flex align-items-center gap-1">
                <button type="button"
                        class="btn btn-outline-secondary btn-sm js-supp-page"
                        data-page="@(pageNumber - 1)"
                        @(pageNumber <= 1 ? "disabled" : null)>
                    Previous
                </button>

                @for (var p = 1; p <= totalPages; p++)
                {
                    <button type="button"
                            class="btn btn-sm js-supp-page @(p == pageNumber ? "btn-dark" : "btn-outline-secondary")"
                            data-page="@p">
                        @p
                    </button>
                }

                <button type="button"
                        class="btn btn-outline-secondary btn-sm js-supp-page"
                        data-page="@(pageNumber + 1)"
                        @(pageNumber >= totalPages ? "disabled" : null)>
                    Next
                </button>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        (function () {
            var filterForm = document.getElementById('supplierFilterForm');
            var pageInput = document.getElementById('supplierPageNumber');

            var pageBtns = document.querySelectorAll('.js-supp-page');
            for (var i = 0; i < pageBtns.length; i++) {
                pageBtns[i].addEventListener('click', function () {
                    var targetPage = this.getAttribute('data-page');
                    if (targetPage && filterForm && pageInput) {
                        pageInput.value = targetPage;
                        filterForm.submit();
                    }
                });
            }

            var toggleForms = document.querySelectorAll('.js-toggle-supplier');
            for (var j = 0; j < toggleForms.length; j++) {
                toggleForms[j].addEventListener('submit', function (e) {
                    e.preventDefault();
                    var formEl = this;
                    var active = formEl.getAttribute('data-active') === 'true';
                    if (typeof Swal === 'undefined') {
                        formEl.submit();
                        return;
                    }
                    Swal.fire({
                        title: active ? 'Deactivate supplier?' : 'Activate supplier?',
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: active ? '#dc3545' : '#198754',
                        confirmButtonText: 'Confirm'
                    }).then(function (res) {
                        if (res.isConfirmed) {
                            formEl.submit();
                        }
                    });
                });
            }
        })();
    </script>
}