@model Orvanta.ViewModels.Units.UnitCreateViewModel
@{
    ViewData["Title"] = "Add Unit";
    ViewData["Subtitle"] = "Units";
    Layout = "_AdminLayout";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8 col-xl-7">
        <div class="card">
            <div class="card-header bg-transparent py-3">
                <h2 class="h6 fw-bold mb-0">Create Unit</h2>
                <div class="text-secondary small">Add a measurement unit and short symbol</div>
            </div>

            <div class="card-body">
                @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                {
                    <div class="alert alert-danger py-2 px-3 small mb-3" role="alert">
                        @foreach (var err in ViewData.ModelState[string.Empty]!.Errors)
                        {
                            <div>@err.ErrorMessage</div>
                        }
                    </div>
                }

                <form asp-controller="Units" asp-action="Create" method="post" autocomplete="off">
                    @Html.AntiForgeryToken()

                    <div class="row g-3 mb-4">
                        <div class="col-sm-7">
                            <label asp-for="Name" class="form-label fw-semibold"></label>
                            <input asp-for="Name" class="form-control" placeholder="Kilogram, Piece, Box..." />
                            <span asp-validation-for="Name" class="text-danger small d-block mt-1"></span>
                        </div>

                        <div class="col-sm-5">
                            <label asp-for="Symbol" class="form-label fw-semibold"></label>
                            <input asp-for="Symbol" class="form-control" placeholder="kg, pcs, box" />
                            <span asp-validation-for="Symbol" class="text-danger small d-block mt-1"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-controller="Units" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary">Save Unit</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}