@model Orvanta.ViewModels.Units.UnitDetailsViewModel
@{
    ViewData["Title"] = Model.Name;
    ViewData["Subtitle"] = "Units";
    Layout = "_AdminLayout";
}

@section PageActions {
    <a asp-controller="Units" asp-action="Index" class="btn btn-subtle">Back</a>
    <a asp-controller="Units" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary-dark">Edit</a>
}

<div class="row justify-content-center">
    <div class="col-12 col-md-9 col-lg-7 col-xl-6">
        <div class="data-card">
            <div class="data-card-head d-flex align-items-center justify-content-between">
                <div>
                    <h2 class="h6 fw-semibold mb-0">Unit Details</h2>
                    <div class="text-secondary small">Measurement unit properties and usage</div>
                </div>
                @if (Model.IsActive)
                {
                    <span class="state-pill state-active">Active</span>
                }
                else
                {
                    <span class="state-pill state-inactive">Inactive</span>
                }
            </div>
            <div class="data-card-body">
                <div class="row g-3">
                    <div class="col-sm-6">
                        <div class="info-row-box">
                            <div class="text-secondary small mb-1">Unit Name</div>
                            <div class="fw-semibold">@Model.Name</div>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="info-row-box">
                            <div class="text-secondary small mb-1">Symbol</div>
                            <div><span class="badge-role">@Model.Symbol</span></div>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="info-row-box">
                            <div class="text-secondary small mb-1">Assigned Products</div>
                            <div class="fs-5 fw-bold tabular-num">@Model.ProductsCount</div>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="info-row-box">
                            <div class="text-secondary small mb-1">Unit ID</div>
                            <div class="fs-5 fw-semibold tabular-num text-secondary">#@Model.Id</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>