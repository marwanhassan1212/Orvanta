@model Orvanta.ViewModels.Account.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
    ViewData["Subtitle"] = "Security & Credentials";
    Layout = "_AdminLayout";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-7 col-xl-6">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success border-0 shadow-sm mb-3" style="border-radius: 12px;" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            </div>
        }

        <div class="lux-card">
            <div class="lux-card-header">
                <h2 class="h5 mb-1 fw-semibold">Update Account Password</h2>
                <div class="text-secondary small">Choose a strong password of at least 12 characters</div>
            </div>

            <div class="lux-card-body">
                @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                {
                    <div class="alert alert-danger small mb-3" style="border-radius: 10px;" role="alert">
                        <ul class="mb-0 ps-3">
                            @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
                            {
                                <li>@error.ErrorMessage</li>
                            }
                        </ul>
                    </div>
                }

                <form asp-controller="Account" asp-action="ChangePassword" method="post" autocomplete="off" id="changePasswordForm">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="CurrentPassword" class="form-label"></label>
                        <div class="input-group">
                            <input asp-for="CurrentPassword" class="form-control lux-pass" style="border-right: 0;" />
                            <button type="button" class="btn btn-outline-secondary lux-toggle-pass" tabindex="-1"
                                    style="border-radius: 0 10px 10px 0; border-color: rgba(20, 22, 25, 0.14);">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                    </div>

                    <hr class="my-4" style="opacity: 0.12;" />

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label"></label>
                        <div class="input-group">
                            <input asp-for="NewPassword" id="newPasswordInput" class="form-control lux-pass" style="border-right: 0;" />
                            <button type="button" class="btn btn-outline-secondary lux-toggle-pass" tabindex="-1"
                                    style="border-radius: 0 10px 10px 0; border-color: rgba(20, 22, 25, 0.14);">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <div class="progress mt-2" style="height: 4px; border-radius: 999px; background-color: #EFECE6;">
                            <div class="progress-bar" id="passStrengthBar" style="width: 0%;"></div>
                        </div>
                        <div class="d-flex justify-content-between mt-1">
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                            <span class="text-secondary small" id="passStrengthText">Strength: None</span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label"></label>
                        <div class="input-group">
                            <input asp-for="ConfirmPassword" class="form-control lux-pass" style="border-right: 0;" />
                            <button type="button" class="btn btn-outline-secondary lux-toggle-pass" tabindex="-1"
                                    style="border-radius: 0 10px 10px 0; border-color: rgba(20, 22, 25, 0.14);">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-lux-outline">Cancel</a>
                        <button type="submit" class="btn btn-lux-primary" id="changePassBtn">
                            <span class="spinner-border spinner-border-sm me-2 d-none" id="changePassSpinner" role="status"></span>
                            Save New Password
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            document.querySelectorAll('.lux-toggle-pass').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    const input = this.closest('.input-group')?.querySelector('.lux-pass');
                    const icon = this.querySelector('i');
                    if (!input || !icon) return;
                    const isPass = input.type === 'password';
                    input.type = isPass ? 'text' : 'password';
                    icon.className = isPass ? 'bi bi-eye-slash' : 'bi bi-eye';
                });
            });

            const input = document.getElementById('newPasswordInput');
            const bar = document.getElementById('passStrengthBar');
            const label = document.getElementById('passStrengthText');

            input?.addEventListener('input', function () {
                const val = this.value || '';
                let score = 0;
                if (val.length >= 12) score += 25;
                if (/[A-Z]/.test(val)) score += 25;
                if (/[0-9]/.test(val)) score += 25;
                if (/[^A-Za-z0-9]/.test(val)) score += 25;

                if (!bar || !label) return;
                bar.style.width = score + '%';
                bar.className = 'progress-bar';

                if (!val.length) {
                    label.textContent = 'Strength: None';
                } else if (score <= 25) {
                    bar.classList.add('bg-danger');
                    label.textContent = 'Strength: Weak';
                } else if (score <= 50) {
                    bar.classList.add('bg-warning');
                    label.textContent = 'Strength: Fair';
                } else if (score <= 75) {
                    bar.classList.add('bg-info');
                    label.textContent = 'Strength: Good';
                } else {
                    bar.classList.add('bg-success');
                    label.textContent = 'Strength: Strong';
                }
            });

            const form = document.getElementById('changePasswordForm');
            const btn = document.getElementById('changePassBtn');
            const spinner = document.getElementById('changePassSpinner');

            form?.addEventListener('submit', function () {
                if ($(form).valid() && btn && spinner) {
                    btn.disabled = true;
                    spinner.classList.remove('d-none');
                }
            });
        })();
    </script>
}