@model Orvanta.ViewModels.Account.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
    Layout = null;

    var returnUrl = Model?.ReturnUrl
        ?? ViewData["ReturnUrl"] as string
        ?? Context.Request.Query["ReturnUrl"].ToString();

    var hasGeneralErrors = !ViewData.ModelState.IsValid &&
                           ViewData.ModelState.TryGetValue(string.Empty, out var rootEntry) &&
                           rootEntry.Errors.Count > 0;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In - Orvanta</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@4.0.0-beta3/dist/css/adminlte.min.css" />
    <link rel="stylesheet" href="~/css/orvanta-theme.css" asp-append-version="true" />

    <style>
        .orvanta-auth-shell {
            min-height: 100vh;
            background: radial-gradient(circle at top, #1D222C 0%, #0E1015 65%, #0A0C0F 100%);
        }

        .orvanta-auth-card {
            width: 100%;
            max-width: 430px;
            border-radius: 16px;
            background-color: #FFFFFF;
            box-shadow: 0 24px 60px -20px rgba(0, 0, 0, 0.55);
            overflow: hidden;
        }

            .orvanta-auth-card::before {
                content: "";
                display: block;
                height: 3px;
                background: linear-gradient(90deg, #936821, #E0B96E, #936821);
            }
    </style>
</head>
<body class="orvanta-auth-shell d-flex align-items-center justify-content-center p-3">

    <div class="orvanta-auth-card">
        <div class="p-4 p-sm-5">
            <div class="text-center mb-4">
                <div class="orvanta-brand-badge mx-auto mb-3" style="width: 46px; height: 46px; font-size: 1.3rem;">
                    O
                </div>
                <h1 class="h4 fw-bold mb-1">Orvanta ERP</h1>
                <div class="text-secondary small">Sign in to manage operations and inventory</div>
            </div>

            @if (hasGeneralErrors)
            {
                <div class="alert alert-danger py-2 px-3 small mb-3" role="alert">
                    @foreach (var err in ViewData.ModelState[string.Empty]!.Errors)
                    {
                        <div>@err.ErrorMessage</div>
                    }
                </div>
            }

            <form asp-controller="Account" asp-action="Login" method="post" autocomplete="off">
                @Html.AntiForgeryToken()
                <input asp-for="ReturnUrl" type="hidden" value="@returnUrl" />

                <div class="mb-3">
                    <label asp-for="LoginIdentifier" class="form-label fw-semibold small"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-body-tertiary"><i class="bi bi-person"></i></span>
                        <input asp-for="LoginIdentifier"
                               class="form-control"
                               placeholder="Username or email"
                               autofocus />
                    </div>
                    <span asp-validation-for="LoginIdentifier" class="text-danger small d-block mt-1"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label fw-semibold small"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-body-tertiary"><i class="bi bi-lock"></i></span>
                        <input asp-for="Password"
                               id="loginPasswordInput"
                               type="password"
                               class="form-control"
                               placeholder="••••••••" />
                        <button type="button"
                                class="btn btn-outline-secondary"
                                id="toggleLoginPassword"
                                aria-label="Toggle password visibility">
                            <i class="bi bi-eye" id="toggleLoginPasswordIcon"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger small d-block mt-1"></span>
                </div>

                <div class="d-flex align-items-center justify-content-between mb-4">
                    <div class="form-check">
                        <input asp-for="RememberMe" type="checkbox" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label small text-secondary"></label>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
                    Sign In
                </button>
            </form>
        </div>

        <div class="px-4 py-3 bg-body-tertiary border-top text-center text-secondary small">
            &copy; 2026 <strong>Orvanta</strong> &middot; Enterprise Workspace
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var btn = document.getElementById('toggleLoginPassword');
            var input = document.getElementById('loginPasswordInput');
            var icon = document.getElementById('toggleLoginPasswordIcon');

            if (!btn || !input || !icon) {
                return;
            }

            btn.addEventListener('click', function () {
                var isPassword = input.getAttribute('type') === 'password';
                input.setAttribute('type', isPassword ? 'text' : 'password');
                icon.className = isPassword ? 'bi bi-eye-slash' : 'bi bi-eye';
            });
        })();
    </script>
</body>
</html>