@model Orvanta.ViewModels.Account.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Orvanta</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        .auth-stage {
            min-height: 100vh;
            display: grid;
            grid-template-columns: 1.05fr 0.95fr;
        }

        .auth-brand-pane {
            background: linear-gradient(160deg, #151921 0%, #0C0E12 100%);
            color: #F5F2EB;
            padding: 3rem;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            border-right: 1px solid rgba(212, 170, 94, 0.16);
        }

        .auth-form-pane {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem;
        }

        .auth-box {
            width: 100%;
            max-width: 410px;
            background: var(--bg-surface);
            border: 1px solid var(--hairline);
            border-radius: var(--radius-card);
            padding: 2.25rem 2rem;
            box-shadow: var(--shadow-float);
        }

        @@media (max-width: 991.98px) {
            .auth-stage {
                grid-template-columns: 1fr;
            }

            .auth-brand-pane {
                display: none;
            }
        }
    </style>
</head>
<body>
    <div class="auth-stage">
        <div class="auth-brand-pane">
            <div class="brand-mark-wrap">
                <span class="brand-emblem">O</span>
                <div>
                    <div class="brand-wordmark">Orvanta</div>
                    <div class="brand-edition">Enterprise ERP</div>
                </div>
            </div>

            <div>
                <div class="page-eyebrow mb-2" style="color: var(--gold-bright);">Operations &amp; Control</div>
                <h2 class="font-display fw-bold mb-3" style="font-size: 2.75rem; line-height: 1.1; color: #FFFFFF;">
                    Precision in every movement of stock and sale.
                </h2>
                <p class="mb-0" style="color: rgba(245, 242, 235, 0.68); max-width: 430px; line-height: 1.65;">
                    Manage inventory, warehouses, purchasing, and sales operations from a unified workspace.
                </p>
            </div>

            <div class="small" style="color: rgba(245, 242, 235, 0.45);">
                &copy; 2026 Orvanta
            </div>
        </div>

        <div class="auth-form-pane">
            <div class="auth-box">
                <div class="mb-4">
                    <div class="page-eyebrow">Welcome back</div>
                    <h1 class="font-display fw-bold mb-1" style="font-size: 2.15rem;">Sign in</h1>
                    <p class="text-secondary small mb-0">Enter your credentials to access your workspace.</p>
                </div>

                @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                {
                    <div class="alert alert-danger py-2 px-3 small mb-3" role="alert">
                        @foreach (var err in ViewData.ModelState[string.Empty]!.Errors)
                        {
                            <div>@err.ErrorMessage</div>
                        }
                    </div>
                }

                <form asp-controller="Account" asp-action="Login" method="post" autocomplete="off">
                    @Html.AntiForgeryToken()
                    <input asp-for="ReturnUrl" type="hidden" />

                    <div class="mb-3">
                        <label asp-for="LoginIdentifier" class="form-label"></label>
                        <input asp-for="LoginIdentifier" class="form-control" autofocus />
                        <span asp-validation-for="LoginIdentifier" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <div class="input-group">
                            <input asp-for="Password" id="loginPassword" class="form-control" style="border-right: 0;" />
                            <button type="button" class="btn btn-subtle" id="toggleLoginPass" tabindex="-1"
                                    style="border-radius: 0 var(--radius-control) var(--radius-control) 0;">
                                <i class="bi bi-eye" id="loginPassIcon"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="RememberMe" type="checkbox" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label small text-secondary"></label>
                    </div>

                    <button type="submit" class="btn btn-gold-cta w-100 py-2">Sign In</button>
                </form>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const btn = document.getElementById('toggleLoginPass');
            const input = document.getElementById('loginPassword');
            const icon = document.getElementById('loginPassIcon');

            btn?.addEventListener('click', function () {
                if (!input || !icon) return;
                const isPass = input.type === 'password';
                input.type = isPass ? 'text' : 'password';
                icon.className = isPass ? 'bi bi-eye-slash' : 'bi bi-eye';
            });
        })();
    </script>
</body>
</html>