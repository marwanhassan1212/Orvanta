@model Orvanta.ViewModels.Account.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Orvanta</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
        :root {
            --lux-bg: #F5F3EE;
            --lux-surface: #FFFFFF;
            --lux-obsidian: #111317;
            --lux-ink: #141619;
            --lux-muted: #686D76;
            --lux-gold: #A67C37;
            --lux-border: rgba(20, 22, 25, 0.08);
            --lux-font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
            --lux-font-serif: 'Cormorant Garamond', Georgia, serif;
        }

        body {
            font-family: var(--lux-font-sans);
            background: radial-gradient(circle at top right, rgba(166, 124, 55, 0.09), transparent 45%), var(--lux-bg);
            color: var(--lux-ink);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1.5rem;
        }

        .auth-card {
            width: 100%;
            max-width: 430px;
            background: var(--lux-surface);
            border: 1px solid var(--lux-border);
            border-radius: 18px;
            padding: 2.5rem 2.25rem;
            box-shadow: 0 24px 60px -24px rgba(17, 19, 23, 0.18);
        }

        .auth-brand {
            text-align: center;
            margin-bottom: 2rem;
        }

        .auth-mark {
            width: 46px;
            height: 46px;
            border-radius: 12px;
            background: linear-gradient(135deg, #C49A52 0%, #8C6426 100%);
            color: #111317;
            font-family: var(--lux-font-serif);
            font-weight: 700;
            font-size: 1.7rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 0.75rem;
        }

        .auth-title {
            font-family: var(--lux-font-serif);
            font-size: 2rem;
            font-weight: 700;
            line-height: 1.1;
            margin: 0;
        }

        .auth-subtitle {
            font-size: 0.875rem;
            color: var(--lux-muted);
            margin-top: 0.35rem;
        }

        .form-label {
            font-size: 0.8rem;
            font-weight: 600;
            color: #2B2F36;
        }

        .form-control {
            border-radius: 10px;
            border: 1px solid rgba(20, 22, 25, 0.14);
            padding: 0.65rem 0.9rem;
            font-size: 0.9rem;
        }

            .form-control:focus {
                border-color: var(--lux-gold);
                box-shadow: 0 0 0 3px rgba(166, 124, 55, 0.14);
            }

        .btn-auth {
            width: 100%;
            background: var(--lux-obsidian);
            color: #FFFFFF;
            border: none;
            border-radius: 10px;
            padding: 0.72rem 1.2rem;
            font-weight: 600;
            font-size: 0.92rem;
            transition: all 0.2s ease;
        }

            .btn-auth:hover {
                background: #232730;
                color: #F3D59B;
            }
    </style>
</head>
<body>
    <div class="auth-card">
        <div class="auth-brand">
            <div class="auth-mark">O</div>
            <h1 class="auth-title">Welcome back</h1>
            <p class="auth-subtitle">Sign in to your Orvanta workspace</p>
        </div>

        @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
        {
            <div class="alert alert-danger py-2 px-3 small mb-3" style="border-radius: 10px;" role="alert">
                @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
                {
                    <div>@error.ErrorMessage</div>
                }
            </div>
        }

        <form asp-controller="Account" asp-action="Login" method="post" autocomplete="off" id="loginForm">
            @Html.AntiForgeryToken()
            <input asp-for="ReturnUrl" type="hidden" />

            <div class="mb-3">
                <label asp-for="LoginIdentifier" class="form-label"></label>
                <input asp-for="LoginIdentifier" class="form-control" placeholder="name@company.com or username" autofocus />
                <span asp-validation-for="LoginIdentifier" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <div class="input-group">
                    <input asp-for="Password" id="loginPassword" class="form-control" placeholder="Enter your password" style="border-right: 0;" />
                    <button type="button" class="btn btn-outline-secondary" id="toggleLoginPassword" tabindex="-1"
                            style="border-radius: 0 10px 10px 0; border-color: rgba(20, 22, 25, 0.14);">
                        <i class="bi bi-eye" id="toggleLoginPasswordIcon"></i>
                    </button>
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <div class="form-check">
                    <input asp-for="RememberMe" type="checkbox" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label small text-secondary"></label>
                </div>
            </div>

            <button type="submit" class="btn-auth" id="loginSubmitBtn">
                <span class="spinner-border spinner-border-sm me-2 d-none" id="loginSpinner" role="status"></span>
                <span id="loginBtnText">Sign In</span>
            </button>
        </form>

        <div class="text-center mt-4" style="font-size: 0.78rem; color: var(--lux-muted);">
            &copy; 2026 Orvanta. All rights reserved.
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const toggleBtn = document.getElementById('toggleLoginPassword');
            const passInput = document.getElementById('loginPassword');
            const icon = document.getElementById('toggleLoginPasswordIcon');
            const form = document.getElementById('loginForm');
            const btn = document.getElementById('loginSubmitBtn');
            const spinner = document.getElementById('loginSpinner');
            const btnText = document.getElementById('loginBtnText');

            toggleBtn?.addEventListener('click', function () {
                if (!passInput || !icon) return;
                const isPass = passInput.type === 'password';
                passInput.type = isPass ? 'text' : 'password';
                icon.className = isPass ? 'bi bi-eye-slash' : 'bi bi-eye';
            });

            form?.addEventListener('submit', function () {
                if ($(form).valid() && btn && spinner && btnText) {
                    btn.disabled = true;
                    spinner.classList.remove('d-none');
                    btnText.textContent = 'Signing in...';
                }
            });
        })();
    </script>
</body>
</html>