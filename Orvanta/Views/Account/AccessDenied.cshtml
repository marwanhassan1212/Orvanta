@{
    ViewData["Title"] = "Access Denied";
    Layout = "_AdminLayout";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-7 col-lg-5">
        <div class="data-card">
            <div class="data-card-body py-5 text-center">
                <div class="font-display fw-bold mb-1" style="font-size: 3.4rem; line-height: 1; color: var(--gold-primary);">403</div>
                <h2 class="h5 fw-semibold mb-2">Restricted Access</h2>
                <p class="text-secondary small mb-4">Your current role does not have permission to view this section.</p>
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary-dark">Back to Overview</a>
            </div>
        </div>
    </div>
</div>