@{
    ViewData["Title"] = "Access Denied";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Orvanta</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
        body {
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
            background-color: #F5F3EE;
            color: #141619;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1.5rem;
        }

        .denied-box {
            max-width: 460px;
            width: 100%;
            background: #FFFFFF;
            border: 1px solid rgba(20, 22, 25, 0.08);
            border-radius: 18px;
            padding: 2.75rem 2.25rem;
            text-align: center;
            box-shadow: 0 24px 60px -24px rgba(17, 19, 23, 0.16);
        }

        .denied-code {
            font-family: 'Cormorant Garamond', Georgia, serif;
            font-size: 4rem;
            font-weight: 700;
            line-height: 1;
            color: #A67C37;
        }
    </style>
</head>
<body>
    <div class="denied-box">
        <div class="denied-code">403</div>
        <h1 class="h4 fw-bold mt-2 mb-2">Restricted Access</h1>
        <p class="text-secondary small mb-4">
            Your current role does not permit viewing this section. Please contact an administrator if you require elevated access.
        </p>
        <div class="d-flex justify-content-center gap-2">
            <a asp-controller="Home" asp-action="Index" class="btn btn-dark px-4" style="border-radius: 10px;">
                Return to Overview
            </a>
            <button type="button" onclick="history.back()" class="btn btn-outline-secondary px-3" style="border-radius: 10px;">
                Go Back
            </button>
        </div>
    </div>
</body>
</html>