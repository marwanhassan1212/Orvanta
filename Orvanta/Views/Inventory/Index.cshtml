@using Orvanta.ViewModels.Inventory
@model dynamic
@{
    ViewData["Title"] = "Inventory Stock";
    ViewData["Subtitle"] = "Inventory";
    Layout = "_AdminLayout";

    var canCreateOpening = User.IsInRole("Admin") || User.IsInRole("Manager") || User.IsInRole("Accountant");
    var defaultFilter = new InventoryStockFilterViewModel();
    var searchTerm = Context.Request.Query["SearchTerm"].ToString();
    var prodIdStr = Context.Request.Query["ProductId"].ToString();
    int? productIdFilter = int.TryParse(prodIdStr, out var pId) && pId > 0 ? pId : null;

    var whIdStr = Context.Request.Query["WarehouseId"].ToString();
    int? warehouseIdFilter = int.TryParse(whIdStr, out var wId) && wId > 0 ? wId : null;

    var lowStockStr = Context.Request.Query["IsLowStock"].ToString();
    bool? isLowStockFilter = bool.TryParse(lowStockStr, out var lStock) ? lStock : null;

    var sortByRaw = Context.Request.Query["SortBy"].ToString();
    var sortBy = string.IsNullOrWhiteSpace(sortByRaw) ? defaultFilter.SortBy : sortByRaw;

    var sortDirRaw = Context.Request.Query["SortDirection"].ToString();
    var sortDir = string.IsNullOrWhiteSpace(sortDirRaw) ? defaultFilter.SortDirection.ToLower() : sortDirRaw.ToLower();

    int queryPage = int.TryParse(Context.Request.Query["PageNumber"], out var qPage) && qPage > 0 ? qPage : defaultFilter.PageNumber;
    int queryPageSize = int.TryParse(Context.Request.Query["PageSize"], out var qSize) && qSize > 0 ? qSize : defaultFilter.PageSize;

    var rawItems = Model?.Items as System.Collections.IEnumerable ?? Model as System.Collections.IEnumerable;
    var list = new List<InventoryStockListViewModel>();
    if (rawItems != null)
    {
        foreach (var row in rawItems)
        {
            if (row is InventoryStockListViewModel vm)
            {
                list.Add(vm);
            }
        }
    }

    int totalCount = Model?.TotalCount != null ? (int)Model.TotalCount : list.Count;
    int pageNumber = Model?.PageNumber != null ? (int)Model.PageNumber : queryPage;
    int pageSize = Model?.PageSize != null ? (int)Model.PageSize : queryPageSize;
    int totalPages = Model?.TotalPages != null ? (int)Model.TotalPages : (totalCount > 0 ? ((totalCount - 1) / pageSize) + 1 : 1);
    if (totalPages < 1) { totalPages = 1; }

    decimal viewTotalQty = 0m;
    decimal viewTotalValue = 0m;
    foreach (var row in list)
    {
        viewTotalQty += row.Quantity;
        viewTotalValue += row.TotalValue;
    }
}

@section PageActions {
    <a asp-controller="Inventory" asp-action="Transactions" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left-right me-1"></i> Transactions
    </a>
    @if (canCreateOpening)
    {
        <a asp-controller="Inventory" asp-action="CreateOpeningBalance" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i> Opening Balance
        </a>
    }
}

<div class="row g-3 mb-4">
    <div class="col-12 col-md-4">
        <div class="card h-100">
            <div class="card-body d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-secondary small fw-semibold">Stock Records</div>
                    <div class="fs-2 fw-bold mt-1">@totalCount</div>
                </div>
                <span class="rounded-3 bg-light p-3 text-dark fs-4">
                    <i class="bi bi-boxes"></i>
                </span>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-4">
        <div class="card h-100">
            <div class="card-body d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-secondary small fw-semibold">Total Qty (Current View)</div>
                    <div class="fs-2 fw-bold mt-1 text-success">@viewTotalQty.ToString("N2")</div>
                </div>
                <span class="rounded-3 bg-success-subtle p-3 text-success fs-4">
                    <i class="bi bi-layers"></i>
                </span>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-4">
        <div class="card h-100">
            <div class="card-body d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-secondary small fw-semibold">Inventory Value (View)</div>
                    <div class="fs-2 fw-bold mt-1 orvanta-gold-text">@viewTotalValue.ToString("N2")</div>
                </div>
                <span class="rounded-3 bg-warning-subtle p-3 text-warning fs-4">
                    <i class="bi bi-cash-stack"></i>
                </span>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header bg-transparent py-3">
        <form asp-controller="Inventory" asp-action="Index" method="get" id="stockFilterForm"
              class="d-flex flex-wrap flex-xl-nowrap align-items-center justify-content-between gap-2">
            <div class="d-flex flex-wrap flex-xl-nowrap align-items-center gap-2 flex-grow-1">
                <input type="text"
                       name="SearchTerm"
                       value="@searchTerm"
                       class="form-control form-control-sm"
                       style="min-width: 240px;"
                       placeholder="Search product or warehouse name..." />

                @if (productIdFilter.HasValue)
                {
                    <input type="hidden" name="ProductId" value="@productIdFilter.Value" />
                }
                @if (warehouseIdFilter.HasValue)
                {
                    <input type="hidden" name="WarehouseId" value="@warehouseIdFilter.Value" />
                }

                <select name="IsLowStock" class="form-select form-select-sm flex-shrink-0" style="width: 150px;">
                    <option value="">All Stock Levels</option>
                    <option value="true" selected="@(isLowStockFilter == true ? "selected" : null)">Low Stock</option>
                    <option value="false" selected="@(isLowStockFilter == false ? "selected" : null)">Normal Stock</option>
                </select>

                <select name="SortBy" class="form-select form-select-sm flex-shrink-0" style="width: 155px;">
                    <option value="ProductName" selected="@(sortBy == "ProductName" ? "selected" : null)">Sort: Product</option>
                    <option value="WarehouseName" selected="@(sortBy == "WarehouseName" ? "selected" : null)">Sort: Warehouse</option>
                    <option value="Quantity" selected="@(sortBy == "Quantity" ? "selected" : null)">Sort: Quantity</option>
                    <option value="UpdatedAt" selected="@(sortBy == "UpdatedAt" ? "selected" : null)">Sort: Updated</option>
                </select>

                <select name="SortDirection" class="form-select form-select-sm flex-shrink-0" style="width: 105px;">
                    <option value="asc" selected="@(sortDir == "asc" ? "selected" : null)">Asc</option>
                    <option value="desc" selected="@(sortDir == "desc" ? "selected" : null)">Desc</option>
                </select>

                <input type="hidden" name="PageNumber" id="stockPageNumber" value="1" />
                <input type="hidden" name="PageSize" value="@pageSize" />

                <button type="submit" class="btn btn-dark btn-sm flex-shrink-0 px-3">Filter</button>
                <a asp-controller="Inventory" asp-action="Index" class="btn btn-outline-secondary btn-sm flex-shrink-0">Reset</a>
            </div>

            <span class="text-secondary small text-nowrap ms-xl-2">@totalCount records</span>
        </form>
    </div>

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="inventoryStockTable">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Product</th>
                        <th>SKU</th>
                        <th>Warehouse</th>
                        <th>Quantity</th>
                        <th>Avg. Cost</th>
                        <th>Total Value</th>
                        <th>Updated</th>
                        <th class="pe-4 text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (list.Count == 0)
                    {
                        <tr>
                            <td colspan="8" class="text-center text-secondary py-5">No inventory stock records found.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in list)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold">@item.ProductName</td>
                                <td>
                                    <code class="text-dark bg-body-tertiary px-2 py-1 rounded border">@item.SKU</code>
                                </td>
                                <td class="text-secondary">@item.WarehouseName</td>
                                <td>
                                    @if (item.Quantity <= 0m)
                                    {
                                        <span class="badge text-bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-2">@item.Quantity.ToString("N2")</span>
                                    }
                                    else
                                    {
                                        <span class="fw-semibold">@item.Quantity.ToString("N2")</span>
                                    }
                                </td>
                                <td class="text-secondary">@item.AverageCost.ToString("N2")</td>
                                <td class="fw-semibold">@item.TotalValue.ToString("N2")</td>
                                <td class="text-secondary small">@item.UpdatedAt.ToString("yyyy-MM-dd")</td>
                                <td class="pe-4 text-end">
                                    <div class="d-inline-flex align-items-center gap-1">
                                        <a asp-controller="Inventory"
                                           asp-action="Details"
                                           asp-route-productId="@item.ProductId"
                                           asp-route-warehouseId="@item.WarehouseId"
                                           class="btn btn-sm btn-outline-secondary"
                                           title="Details">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        <a asp-controller="Inventory"
                                           asp-action="Transactions"
                                           asp-route-ProductId="@item.ProductId"
                                           asp-route-WarehouseId="@item.WarehouseId"
                                           class="btn btn-sm btn-outline-secondary"
                                           title="Transactions">
                                            <i class="bi bi-clock-history"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (totalPages > 1)
    {
        <div class="card-footer bg-transparent d-flex flex-wrap align-items-center justify-content-between gap-2">
            <div class="text-secondary small">
                Page @pageNumber of @totalPages
            </div>

            <div class="d-flex align-items-center gap-1">
                <button type="button"
                        class="btn btn-outline-secondary btn-sm js-stock-page"
                        data-page="@(pageNumber - 1)"
                        @(pageNumber <= 1 ? "disabled" : null)>
                    Previous
                </button>

                @for (var p = 1; p <= totalPages; p++)
                {
                    <button type="button"
                            class="btn btn-sm js-stock-page @(p == pageNumber ? "btn-dark" : "btn-outline-secondary")"
                            data-page="@p">
                        @p
                    </button>
                }

                <button type="button"
                        class="btn btn-outline-secondary btn-sm js-stock-page"
                        data-page="@(pageNumber + 1)"
                        @(pageNumber >= totalPages ? "disabled" : null)>
                    Next
                </button>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        (function () {
            var filterForm = document.getElementById('stockFilterForm');
            var pageInput = document.getElementById('stockPageNumber');

            var pageBtns = document.querySelectorAll('.js-stock-page');
            for (var i = 0; i < pageBtns.length; i++) {
                pageBtns[i].addEventListener('click', function () {
                    var targetPage = this.getAttribute('data-page');
                    if (targetPage && filterForm && pageInput) {
                        pageInput.value = targetPage;
                        filterForm.submit();
                    }
                });
            }
        })();
    </script>
}