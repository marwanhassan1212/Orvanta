@model IEnumerable<Orvanta.ViewModels.Users.UserListViewModel>
@{
    ViewData["Title"] = "Users";
    ViewData["Subtitle"] = "Administration";
    Layout = "_AdminLayout";

    var totalUsers = Model.Count();
    var activeUsers = Model.Count(u => u.IsActive);
    var inactiveUsers = totalUsers - activeUsers;
}

@section PageActions {
    <a asp-controller="UserManagement" asp-action="Create" class="btn btn-gold-cta">
        <i class="bi bi-plus-lg me-1"></i> Add User
    </a>
}

<div class="row g-3 mb-4">
    <div class="col-12 col-md-4">
        <div class="summary-box d-flex align-items-center justify-content-between">
            <div>
                <div class="text-secondary small fw-medium">Total Accounts</div>
                <div class="fs-2 fw-bold tabular-num mt-1">@totalUsers</div>
            </div>
            <span class="summary-badge"><i class="bi bi-people"></i></span>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="summary-box d-flex align-items-center justify-content-between">
            <div>
                <div class="text-secondary small fw-medium">Active Accounts</div>
                <div class="fs-2 fw-bold tabular-num mt-1 text-success">@activeUsers</div>
            </div>
            <span class="summary-badge summary-badge-ok"><i class="bi bi-check2-circle"></i></span>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="summary-box d-flex align-items-center justify-content-between">
            <div>
                <div class="text-secondary small fw-medium">Inactive Accounts</div>
                <div class="fs-2 fw-bold tabular-num mt-1 text-danger">@inactiveUsers</div>
            </div>
            <span class="summary-badge summary-badge-muted"><i class="bi bi-slash-circle"></i></span>
        </div>
    </div>
</div>

<div class="data-card">
    <div class="data-card-head d-flex flex-wrap flex-md-nowrap align-items-center justify-content-between gap-3">
        <div class="d-flex align-items-center gap-2 flex-grow-1" style="max-width: 500px;">
            <input type="text" id="userSearch" class="form-control" placeholder="Search by name, email or role..." />
            <select id="userRoleFilter" class="form-select flex-shrink-0" style="width: 185px;">
                <option value="">All Roles</option>
                <option value="Admin">Admin</option>
                <option value="Manager">Manager</option>
                <option value="Accountant">Accountant</option>
                <option value="SalesEmployee">SalesEmployee</option>
                <option value="WarehouseEmployee">WarehouseEmployee</option>
            </select>
        </div>
        <span class="text-secondary small tabular-num text-nowrap" id="userCountLabel">@totalUsers records</span>
    </div>

    <div class="table-responsive">
        <table class="table grid-table mb-0" id="usersTable">
            <thead>
                <tr>
                    <th class="ps-4">User</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th class="pe-4 text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center text-secondary py-5">No users found.</td>
                    </tr>
                }
                else
                {
                    foreach (var user in Model)
                    {
                        var initials = string.Join("",
                        (user.FullName ?? "U")
                        .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                        .Take(2)
                        .Select(s => char.ToUpperInvariant(s[0])));

                        <tr class="user-row" data-role="@user.Role">
                            <td class="ps-4">
                                <div class="d-flex align-items-center gap-3">
                                    <span class="profile-chip">@initials</span>
                                    <span class="fw-semibold">@user.FullName</span>
                                </div>
                            </td>
                            <td class="text-secondary">@user.Email</td>
                            <td><span class="badge-role">@user.Role</span></td>
                            <td>
                                @if (user.IsActive)
                                {
                                    <span class="state-pill state-active">Active</span>
                                }
                                else
                                {
                                    <span class="state-pill state-inactive">Inactive</span>
                                }
                            </td>
                            <td class="pe-4 text-end">
                                <div class="d-inline-flex align-items-center gap-2">
                                    <a asp-controller="UserManagement"
                                       asp-action="Edit"
                                       asp-route-id="@user.Id"
                                       class="action-btn"
                                       title="Edit">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>

                                    <form asp-controller="UserManagement"
                                          asp-action="ToggleStatus"
                                          asp-route-id="@user.Id"
                                          method="post"
                                          class="d-inline m-0 js-toggle-user"
                                          data-active="@user.IsActive.ToString().ToLower()">
                                        @Html.AntiForgeryToken()
                                        @if (user.IsActive)
                                        {
                                            <button type="submit"
                                                    class="action-btn action-btn-danger"
                                                    title="Deactivate">
                                                <i class="bi bi-person-slash"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit"
                                                    class="action-btn action-btn-success"
                                                    title="Activate">
                                                <i class="bi bi-person-check"></i>
                                            </button>
                                        }
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const search = document.getElementById('userSearch');
            const roleFilter = document.getElementById('userRoleFilter');
            const rows = Array.from(document.querySelectorAll('#usersTable tbody tr.user-row'));
            const counter = document.getElementById('userCountLabel');

            function applyFilter() {
                const q = (search?.value || '').trim().toLowerCase();
                const role = roleFilter?.value || '';
                let visible = 0;

                rows.forEach(function (row) {
                    const textMatch = !q || row.textContent.toLowerCase().includes(q);
                    const roleMatch = !role || row.getAttribute('data-role') === role;
                    const show = textMatch && roleMatch;
                    row.style.display = show ? '' : 'none';
                    if (show) visible++;
                });

                if (counter) counter.textContent = `${visible} records`;
            }

            search?.addEventListener('input', applyFilter);
            roleFilter?.addEventListener('change', applyFilter);

            document.querySelectorAll('.js-toggle-user').forEach(function (form) {
                form.addEventListener('submit', function (e) {
                    e.preventDefault();
                    const active = form.getAttribute('data-active') === 'true';
                    if (typeof Swal === 'undefined') {
                        form.submit();
                        return;
                    }
                    Swal.fire({
                        title: active ? 'Deactivate user?' : 'Activate user?',
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: active ? '#b02a37' : '#111317',
                        confirmButtonText: 'Confirm'
                    }).then(function (res) {
                        if (res.isConfirmed) form.submit();
                    });
                });
            });
        })();
    </script>
}