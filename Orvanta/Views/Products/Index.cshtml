@using Orvanta.ViewModels.Products
@model dynamic
@{
    ViewData["Title"] = "Products";
    ViewData["Subtitle"] = "Catalog & Partners";
    Layout = "_AdminLayout";

    var canManage = User.IsInRole("Admin") || User.IsInRole("Manager");
    var defaultFilter = new ProductFilterViewModel();

    var searchTerm = Context.Request.Query["SearchTerm"].ToString();
    var catIdStr = Context.Request.Query["CategoryId"].ToString();
    int? categoryIdFilter = int.TryParse(catIdStr, out var parsedCatId) ? parsedCatId : null;

    var unitIdStr = Context.Request.Query["UnitId"].ToString();
    int? unitIdFilter = int.TryParse(unitIdStr, out var parsedUnitId) ? parsedUnitId : null;

    var isActiveQuery = Context.Request.Query["IsActive"].ToString();
    bool? isActiveFilter = bool.TryParse(isActiveQuery, out var parsedActive) ? parsedActive : null;

    var sortByRaw = Context.Request.Query["SortBy"].ToString();
    var sortBy = string.IsNullOrWhiteSpace(sortByRaw) ? defaultFilter.SortBy.ToLower() : sortByRaw.ToLower();

    var sortDirRaw = Context.Request.Query["SortDirection"].ToString();
    var sortDir = string.IsNullOrWhiteSpace(sortDirRaw) ? defaultFilter.SortDirection.ToLower() : sortDirRaw.ToLower();

    int queryPage = int.TryParse(Context.Request.Query["PageNumber"], out var qPage) && qPage > 0 ? qPage : defaultFilter.PageNumber;
    int queryPageSize = int.TryParse(Context.Request.Query["PageSize"], out var qSize) && qSize > 0 ? qSize : defaultFilter.PageSize;

    var rawItems = Model?.Items as System.Collections.IEnumerable ?? Model as System.Collections.IEnumerable;
    var list = new List<ProductListViewModel>();
    if (rawItems != null)
    {
        foreach (var row in rawItems)
        {
            if (row is ProductListViewModel vm)
            {
                list.Add(vm);
            }
        }
    }

    int totalCount = Model?.TotalCount != null ? (int)Model.TotalCount : list.Count;
    int pageNumber = Model?.PageNumber != null ? (int)Model.PageNumber : queryPage;
    int pageSize = Model?.PageSize != null ? (int)Model.PageSize : queryPageSize;
    int totalPages = Model?.TotalPages != null ? (int)Model.TotalPages : (totalCount > 0 ? ((totalCount - 1) / pageSize) + 1 : 1);
    if (totalPages < 1) { totalPages = 1; }

    int activeCount = 0;
    decimal viewSalesTotal = 0m;
    foreach (var row in list)
    {
        if (row.IsActive) { activeCount++; }
        viewSalesTotal += row.SellingPrice;
    }
}

@if (canManage)
{
    @section PageActions {
        <a asp-controller="Products" asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i> Add Product
        </a>
    }
}

<div class="row g-3 mb-4">
    <div class="col-12 col-md-4">
        <div class="card h-100">
            <div class="card-body d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-secondary small fw-semibold">Total Products</div>
                    <div class="fs-2 fw-bold mt-1">@totalCount</div>
                </div>
                <span class="rounded-3 bg-light p-3 text-dark fs-4">
                    <i class="bi bi-box-seam"></i>
                </span>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-4">
        <div class="card h-100">
            <div class="card-body d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-secondary small fw-semibold">Active</div>
                    <div class="fs-2 fw-bold mt-1 text-success">@activeCount</div>
                </div>
                <span class="rounded-3 bg-success-subtle p-3 text-success fs-4">
                    <i class="bi bi-check2-circle"></i>
                </span>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-4">
        <div class="card h-100">
            <div class="card-body d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-secondary small fw-semibold">Sum of Selling Prices</div>
                    <div class="fs-2 fw-bold mt-1 orvanta-gold-text">@viewSalesTotal.ToString("N2")</div>
                </div>
                <span class="rounded-3 bg-warning-subtle p-3 text-warning fs-4">
                    <i class="bi bi-tag"></i>
                </span>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header bg-transparent py-3">
        <form asp-controller="Products" asp-action="Index" method="get" id="productFilterForm"
              class="d-flex flex-wrap flex-lg-nowrap align-items-center justify-content-between gap-2">
            <div class="d-flex flex-wrap flex-md-nowrap align-items-center gap-2 flex-grow-1">
                <input type="text"
                       name="SearchTerm"
                       value="@searchTerm"
                       class="form-control"
                       style="min-width: 200px;"
                       placeholder="Search name or SKU..." />

                @if (categoryIdFilter.HasValue)
                {
                    <input type="hidden" name="CategoryId" value="@categoryIdFilter.Value" />
                }
                @if (unitIdFilter.HasValue)
                {
                    <input type="hidden" name="UnitId" value="@unitIdFilter.Value" />
                }

                <select name="IsActive" class="form-select flex-shrink-0" style="width: 150px;">
                    <option value="">All Statuses</option>
                    <option value="true" selected="@(isActiveFilter == true ? "selected" : null)">Active</option>
                    <option value="false" selected="@(isActiveFilter == false ? "selected" : null)">Inactive</option>
                </select>

                <select name="SortBy" class="form-select flex-shrink-0" style="width: 155px;">
                    <option value="name" selected="@(sortBy == "name" ? "selected" : null)">Sort: Name</option>
                    <option value="sku" selected="@(sortBy == "sku" ? "selected" : null)">Sort: SKU</option>
                    <option value="sellingprice" selected="@(sortBy == "sellingprice" ? "selected" : null)">Sort: Price</option>
                </select>

                <select name="SortDirection" class="form-select flex-shrink-0" style="width: 115px;">
                    <option value="asc" selected="@(sortDir == "asc" ? "selected" : null)">Asc</option>
                    <option value="desc" selected="@(sortDir == "desc" ? "selected" : null)">Desc</option>
                </select>

                <input type="hidden" name="PageNumber" id="productPageNumber" value="1" />
                <input type="hidden" name="PageSize" value="@pageSize" />

                <button type="submit" class="btn btn-dark flex-shrink-0">Filter</button>
                <a asp-controller="Products" asp-action="Index" class="btn btn-outline-secondary flex-shrink-0">Reset</a>
            </div>

            <span class="text-secondary small text-nowrap ms-lg-2">@totalCount records</span>
        </form>
    </div>

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="productsTable">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Product</th>
                        <th>SKU</th>
                        <th>Category</th>
                        <th>Unit</th>
                        <th>Selling Price</th>
                        <th>Status</th>
                        <th class="pe-4 text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (list.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="text-center text-secondary py-5">No products found.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in list)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold">@item.Name</td>
                                <td>
                                    <code class="text-dark bg-body-tertiary px-2 py-1 rounded border">@item.SKU</code>
                                </td>
                                <td class="text-secondary">
                                    @(string.IsNullOrWhiteSpace(item.CategoryName) ? "—" : item.CategoryName)
                                </td>
                                <td class="text-secondary">
                                    @(string.IsNullOrWhiteSpace(item.UnitName) ? "—" : item.UnitName)
                                </td>
                                <td class="fw-semibold">@item.SellingPrice.ToString("N2")</td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge text-bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-2">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-2">Inactive</span>
                                    }
                                </td>
                                <td class="pe-4 text-end">
                                    <div class="d-inline-flex align-items-center gap-1">
                                        <a asp-controller="Products"
                                           asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-secondary"
                                           title="Details">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        @if (canManage)
                                        {
                                            <a asp-controller="Products"
                                               asp-action="Edit"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-secondary"
                                               title="Edit">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>

                                            <form asp-controller="Products"
                                                  asp-action="ToggleStatus"
                                                  asp-route-id="@item.Id"
                                                  method="post"
                                                  class="d-inline m-0 js-toggle-product"
                                                  data-active="@(item.IsActive ? "true" : "false")">
                                                @Html.AntiForgeryToken()
                                                @if (item.IsActive)
                                                {
                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-danger"
                                                            title="Deactivate">
                                                        <i class="bi bi-slash-circle"></i>
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-success"
                                                            title="Activate">
                                                        <i class="bi bi-check-circle"></i>
                                                    </button>
                                                }
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (totalPages > 1)
    {
        <div class="card-footer bg-transparent d-flex flex-wrap align-items-center justify-content-between gap-2">
            <div class="text-secondary small">
                Page @pageNumber of @totalPages
            </div>

            <div class="d-flex align-items-center gap-1">
                <button type="button"
                        class="btn btn-outline-secondary btn-sm js-prod-page"
                        data-page="@(pageNumber - 1)"
                        @(pageNumber <= 1 ? "disabled" : null)>
                    Previous
                </button>

                @for (var p = 1; p <= totalPages; p++)
                {
                    <button type="button"
                            class="btn btn-sm js-prod-page @(p == pageNumber ? "btn-dark" : "btn-outline-secondary")"
                            data-page="@p">
                        @p
                    </button>
                }

                <button type="button"
                        class="btn btn-outline-secondary btn-sm js-prod-page"
                        data-page="@(pageNumber + 1)"
                        @(pageNumber >= totalPages ? "disabled" : null)>
                    Next
                </button>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        (function () {
            var filterForm = document.getElementById('productFilterForm');
            var pageInput = document.getElementById('productPageNumber');

            var pageBtns = document.querySelectorAll('.js-prod-page');
            for (var i = 0; i < pageBtns.length; i++) {
                pageBtns[i].addEventListener('click', function () {
                    var targetPage = this.getAttribute('data-page');
                    if (targetPage && filterForm && pageInput) {
                        pageInput.value = targetPage;
                        filterForm.submit();
                    }
                });
            }

            var toggleForms = document.querySelectorAll('.js-toggle-product');
            for (var j = 0; j < toggleForms.length; j++) {
                toggleForms[j].addEventListener('submit', function (e) {
                    e.preventDefault();
                    var formEl = this;
                    var active = formEl.getAttribute('data-active') === 'true';
                    if (typeof Swal === 'undefined') {
                        formEl.submit();
                        return;
                    }
                    Swal.fire({
                        title: active ? 'Deactivate product?' : 'Activate product?',
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: active ? '#dc3545' : '#198754',
                        confirmButtonText: 'Confirm'
                    }).then(function (res) {
                        if (res.isConfirmed) {
                            formEl.submit();
                        }
                    });
                });
            }
        })();
    </script>
}