@model Orvanta.ViewModels.Products.ProductDetailsViewModel
@{
    ViewData["Title"] = Model.Name;
    ViewData["Subtitle"] = "Products";
    Layout = "_AdminLayout";

    var canManage = User.IsInRole("Admin") || User.IsInRole("Manager");
    var margin = Model.SellingPrice - Model.PurchasePrice;
}

@section PageActions {
    <a asp-controller="Products" asp-action="Index" class="btn btn-subtle">Back</a>
    @if (canManage)
    {
        <a asp-controller="Products" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary-dark">Edit</a>
    }
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-9 col-xl-8">
        <div class="data-card">
            <div class="data-card-head d-flex align-items-center justify-content-between">
                <div>
                    <h2 class="h6 fw-semibold mb-0">Product Overview</h2>
                    <div class="text-secondary small">Pricing, classification, and audit details</div>
                </div>
                @if (Model.IsActive)
                {
                    <span class="state-pill state-active">Active</span>
                }
                else
                {
                    <span class="state-pill state-inactive">Inactive</span>
                }
            </div>

            <div class="data-card-body">
                <div class="row g-3">
                    <div class="col-sm-6">
                        <div class="info-row-box h-100">
                            <div class="text-secondary small mb-1">Product Name</div>
                            <div class="fw-semibold">@Model.Name</div>
                        </div>
                    </div>

                    <div class="col-sm-6">
                        <div class="info-row-box h-100">
                            <div class="text-secondary small mb-1">SKU</div>
                            <div><span class="badge-role tabular-num">@Model.SKU</span></div>
                        </div>
                    </div>

                    <div class="col-sm-6">
                        <div class="info-row-box h-100">
                            <div class="text-secondary small mb-1">Category</div>
                            <div class="fw-semibold">@Model.CategoryName</div>
                        </div>
                    </div>

                    <div class="col-sm-6">
                        <div class="info-row-box h-100">
                            <div class="text-secondary small mb-1">Unit</div>
                            <div class="fw-semibold">@Model.UnitName</div>
                        </div>
                    </div>

                    <div class="col-sm-4">
                        <div class="info-row-box h-100">
                            <div class="text-secondary small mb-1">Purchase Price</div>
                            <div class="fs-5 fw-bold tabular-num">@Model.PurchasePrice.ToString("N2")</div>
                        </div>
                    </div>

                    <div class="col-sm-4">
                        <div class="info-row-box h-100">
                            <div class="text-secondary small mb-1">Selling Price</div>
                            <div class="fs-5 fw-bold tabular-num">@Model.SellingPrice.ToString("N2")</div>
                        </div>
                    </div>

                    <div class="col-sm-4">
                        <div class="info-row-box h-100">
                            <div class="text-secondary small mb-1">Gross Spread</div>
                            <div class="fs-5 fw-bold tabular-num @(margin >= 0 ? "text-success" : "text-danger")">
                                @margin.ToString("N2")
                            </div>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="info-row-box">
                            <div class="text-secondary small mb-1">Description</div>
                            <div class="@(string.IsNullOrWhiteSpace(Model.Description) ? "text-secondary fst-italic small" : "")">
                                @(string.IsNullOrWhiteSpace(Model.Description) ? "No description provided." : Model.Description)
                            </div>
                        </div>
                    </div>

                    <div class="col-sm-6">
                        <div class="info-row-box h-100">
                            <div class="text-secondary small mb-1">Created At</div>
                            <div class="small fw-medium tabular-num">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</div>
                        </div>
                    </div>

                    <div class="col-sm-6">
                        <div class="info-row-box h-100">
                            <div class="text-secondary small mb-1">Last Updated</div>
                            <div class="small fw-medium tabular-num">
                                @(Model.UpdatedAt.HasValue? Model.UpdatedAt.Value.ToString("yyyy-MM-dd HH:mm") : "—")
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>