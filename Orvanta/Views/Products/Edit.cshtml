@model Orvanta.ViewModels.Products.ProductUpdateViewModel
@{
    ViewData["Title"] = "Edit Product";
    ViewData["Subtitle"] = "Products";
    Layout = "_AdminLayout";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-9 col-xl-8">
        <div class="card">
            <div class="card-header bg-transparent py-3">
                <h2 class="h6 fw-bold mb-0">Edit Product</h2>
                <div class="text-secondary small">Update product details, category, unit, or pricing</div>
            </div>

            <div class="card-body">
                @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                {
                    <div class="alert alert-danger py-2 px-3 small mb-3" role="alert">
                        @foreach (var err in ViewData.ModelState[string.Empty]!.Errors)
                        {
                            <div>@err.ErrorMessage</div>
                        }
                    </div>
                }

                <form asp-controller="Products" asp-action="Edit" asp-route-id="@Model.Id" method="post" autocomplete="off">
                    @Html.AntiForgeryToken()
                    <input asp-for="Id" type="hidden" />

                    <div class="row g-3 mb-3">
                        <div class="col-sm-7">
                            <label asp-for="Name" class="form-label fw-semibold"></label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger small d-block mt-1"></span>
                        </div>

                        <div class="col-sm-5">
                            <label asp-for="SKU" class="form-label fw-semibold"></label>
                            <input asp-for="SKU" class="form-control" />
                            <span asp-validation-for="SKU" class="text-danger small d-block mt-1"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-sm-6">
                            <label asp-for="CategoryId" class="form-label fw-semibold"></label>
                            <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select">
                                <option value="">-- Select Category --</option>
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger small d-block mt-1"></span>
                        </div>

                        <div class="col-sm-6">
                            <label asp-for="UnitId" class="form-label fw-semibold"></label>
                            <select asp-for="UnitId" asp-items="ViewBag.Units" class="form-select">
                                <option value="">-- Select Unit --</option>
                            </select>
                            <span asp-validation-for="UnitId" class="text-danger small d-block mt-1"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-sm-6">
                            <label asp-for="PurchasePrice" class="form-label fw-semibold"></label>
                            <input asp-for="PurchasePrice" type="number" step="0.01" min="0" class="form-control" />
                            <span asp-validation-for="PurchasePrice" class="text-danger small d-block mt-1"></span>
                        </div>

                        <div class="col-sm-6">
                            <label asp-for="SellingPrice" class="form-label fw-semibold"></label>
                            <input asp-for="SellingPrice" type="number" step="0.01" min="0" class="form-control" />
                            <span asp-validation-for="SellingPrice" class="text-danger small d-block mt-1"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label fw-semibold"></label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Description" class="text-danger small d-block mt-1"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-controller="Products" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}